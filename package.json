{
  "name": "iptvkz",
  "version": "1.2.2",
  "private": true,
  "description": "IPTVKZ — player IPTV pessoal para computador e TV (M3U e Xtream Codes)",
  "scripts": {
    "start": "node src/server/index.js",
    "desktop": "electron .",
    "build": "node scripts/build-legacy.js",
    "vendor": "node scripts/vendor.js",
    "dist:win": "node scripts/build-desktop.js --win",
    "dist:mac": "node scripts/build-desktop.js --mac",
    "dist:linux": "node scripts/build-desktop.js --linux",
    "ipk": "node scripts/build-ipk.js",
    "ipk:store": "node scripts/build-ipk.js --store",
    "ipk:store:fhd": "node scripts/build-ipk.js --store --fhd",
    "android": "node scripts/build-android.js",
    "android:play": "node scripts/build-android.js --play",
    "test": "node --test scripts/test-server.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@webos-tools/cli": "^3.2.6",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "hls.js": "^1.5.17",
    "mpegts.js": "^1.7.3",
    "qrcode-generator": "^2.0.4"
  },
  "allowScripts": {
    "electron@33.2.1": true,
    "esbuild@0.24.0": true
  },
  "main": "platforms/desktop/main.js",
  "author": {
    "name": "Kazama Studios",
    "email": "contato@kazamastudios.com.br"
  },
  "license": "MIT",
  "homepage": "https://github.com/kazamastudios/iptvkz",
  "repository": {
    "type": "git",
    "url": "https://github.com/kazamastudios/iptvkz.git"
  },
  "build": {
    "appId": "com.lucasyemz.iptvkz",
    "productName": "IPTVKZ",
    "copyright": "Copyright © 2026 Kazama Studios",
    "artifactName": "IPTVKZ-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist/desktop"
    },
    "files": [
      "platforms/desktop/**",
      "platforms/windows/iptvkz.ico",
      "platforms/windows/iptvkz-beta.ico",
      "src/server/**",
      "src/web/**",
      "!src/web/**/*.map",
      "assets/brand/icon-1024.png",
      "assets/brand/icon-small-64.png",
      "assets/brand/icon-beta-1024.png",
      "assets/brand/icon-small-beta-64.png",
      "package.json"
    ],
    "win": {
      "icon": "platforms/windows/iptvkz.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "shortcutName": "IPTVKZ",
      "artifactName": "IPTVKZ-${version}-windows-setup.${ext}",
      "license": "src/web/termos.txt"
    },
    "portable": {
      "artifactName": "IPTVKZ-${version}-windows-portable.${ext}"
    },
    "mac": {
      "icon": "assets/brand/icon-mac-1024.png",
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "identity": null
    },
    "linux": {
      "icon": "assets/brand/icon-1024.png",
      "category": "AudioVideo",
      "target": [
        "AppImage",
        "deb"
      ],
      "maintainer": "Kazama Studios <contato@kazamastudios.com.br>"
    },
    "publish": {
      "provider": "github",
      "owner": "kazamastudios",
      "repo": "iptvkz",
      "releaseType": "draft"
    }
  }
}
